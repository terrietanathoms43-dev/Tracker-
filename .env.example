# Copy to .env.local and fill in. Nothing here is read by the browser.

# --- App ---------------------------------------------------------------------
# The public origin. Development: the dev server's port. Production: https://your-domain.
AUTH_URL=http://localhost:3020
AUTH_TRUST_HOST=true
# openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# --- Database (Postgres 16 on the VPS; one database per app) ------------------
# Create it once on the server:  createdb trackwise   (or: CREATE DATABASE trackwise;)
# Then apply the schema from your machine:  npm run db:push
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/trackwise

# --- Google sign-in (optional; the button is hidden until both are set) --------
# Authorised redirect URI in the Google Cloud console: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email: magic links, invitations, notifications ---------------------------
# Without SMTP settings, development prints every email (including sign-in links) to the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL=
EMAIL_PASS=
# EMAIL_FROM="Trackwise <no-reply@your-domain>"

# --- Agent test mode (development only; never set on the server) --------------
# 16+ characters. Lets scripts sign in as the seeded .test personas: see lib/test-mode.ts and AGENTS.md.
TEST_MODE_SECRET=
