# Copy to .env.local and fill in. Nothing here is read by the browser.

# --- App / auth (Better Auth) ---------------------------------------------------
# The public origin. Development: the dev server's port. Production: https://your-domain.
BETTER_AUTH_URL=http://localhost:3015
# openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=
# Who may sign in or be invited: a comma-separated list of email domains (subdomains included). Unset = anyone.
ALLOWED_EMAIL_DOMAINS=intellibus.com

# --- Database (Postgres 16; Neon or the VPS's own) ------------------------------
# Plain Drizzle over `pg`. Neon: the pooled URL here, the direct URL below (drizzle-kit push needs a direct
# connection). A "claimable" Neon database must be claimed to an account before it expires.
DATABASE_URL=postgres://USER:PASSWORD@HOST/trackwise?sslmode=require
DATABASE_URL_DIRECT=

# --- Google sign-in (optional; the button is hidden until both are set) ----------
# Authorised redirect URI in the Google Cloud console: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email: magic links, invitations, notifications -----------------------------
# Without SMTP settings, development prints every email (including sign-in links) to the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL=
EMAIL_PASS=
# EMAIL_FROM="Trackwise <no-reply@your-domain>"

# --- Agent test mode (development only; never set on the server) ----------------
# 16+ characters. Lets scripts sign in as the seeded .test personas: see lib/test-mode.ts and AGENTS.md.
TEST_MODE_SECRET=
