# Copy to .env.local and fill in. Nothing here is read by the browser.

# --- App / auth (Better Auth) ---------------------------------------------------
# The public origin. Development: the dev server's port. Production: https://your-domain.
BETTER_AUTH_URL=http://localhost:3015
# openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=
# Who may sign in or be invited: a comma-separated list of email domains (subdomains included). Leave it empty
# (the default since 2026-11-04) and anyone with an email address can sign in.
ALLOWED_EMAIL_DOMAINS=

# --- Database (Postgres 16; Neon or the VPS's own) ------------------------------
# Plain Drizzle over `pg`. Neon: the pooled URL here, the direct URL below (drizzle-kit push needs a direct
# connection). A "claimable" Neon database must be claimed to an account before it expires.
DATABASE_URL=postgres://USER:PASSWORD@HOST/trackwise?sslmode=require
DATABASE_URL_DIRECT=
# Other environments' databases this machine may copy between with `npm run db:copy -- --from=prod --to=dev`
# (scripts/db-copy.ts; docs/RUNBOOK.md, "Dev, staging and production"). A name maps to <NAME>_DATABASE_URL, with
# the _DIRECT variant used when set. Production is only ever a source. Leave these out on the server.
# PROD_DATABASE_URL=
# PROD_DATABASE_URL_DIRECT=
# DEV_DATABASE_URL=
# DEV_DATABASE_URL_DIRECT=
# STAGING_DATABASE_URL=
# STAGING_DATABASE_URL_DIRECT=
# Where pg_dump and pg_restore live when they are not on PATH (pgAdmin ships them in its runtime folder, found by itself).
# PG_BIN=

# --- Google sign-in (optional; the button is hidden until both are set) ----------
# Authorised redirect URI in the Google Cloud console: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email: magic links, invitations, notifications -----------------------------
# Without SMTP settings, development prints every email (including sign-in links) to the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL=
EMAIL_PASS=
# EMAIL_FROM="Trackwise <no-reply@your-domain>"

# --- Agent test mode (development only; never set on the server) ----------------
# 16+ characters. Lets scripts sign in as the seeded .test personas: see lib/test-mode.ts and AGENTS.md.
TEST_MODE_SECRET=

# --- Capture from a meeting (optional; the page stays hidden until the key is set) ---------------
# A Claude API key. A transcript pasted on /capture is sent to the model to draft goals and tasks (a person
# approves them before anything is created). Nothing is ever sent for the .test personas: they get a plain
# parser so the walkthroughs cost nothing. See lib/capture/availability.ts.
ANTHROPIC_API_KEY=
# The model the helper asks; leave unset for the default.
# CAPTURE_MODEL=claude-opus-5-5
