# Never include local credentials or Git history in the image
.git
.gitignore
.env
.env.*
!.env.example

# Created during local development and regenerated by the build
node_modules
.next
out
dist
coverage
playwright-report
test-results
*.tsbuildinfo

# Editor and OS files
.vscode
.idea
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log
